# Auth0 Regular Web Application (local development)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=generate-with-openssl-rand-hex-32
# API identifier configured in Auth0; the API verifies this audience.
AUTH0_AUDIENCE=https://vtm-app-api
APP_BASE_URL=http://localhost:3000

# Server-only URL of the Vercel project rooted at apps/api.
API_BASE_URL=http://localhost:3001

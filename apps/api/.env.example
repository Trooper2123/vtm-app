# Auth0 API configured with the same audience requested by apps/web.
AUTH0_ISSUER_URL=https://your-tenant.us.auth0.com/
AUTH0_API_AUDIENCE=https://vtm-app-api

# Use the shared Neon Preview/test branch URL here and in the API Vercel Preview environment.
# Never use the production DATABASE_URL for local development or tests.
DATABASE_URL=

# Public frontend origin (only needed if browser requests call this API directly).
WEB_ORIGIN=http://localhost:3000
